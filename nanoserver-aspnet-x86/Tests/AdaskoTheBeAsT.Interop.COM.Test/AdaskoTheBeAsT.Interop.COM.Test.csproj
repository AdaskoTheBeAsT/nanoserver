<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net48;net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <Platforms>x86;x64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AdaskoTheBeAsT.Interop.COM" Version="4.2.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.NativeCOM">
      <HintPath>..\native\Interop.NativeCOM.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\native\NativeShimRegression.exe" Link="NativeShimRegression.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\NativeCOM.dll" Link="NativeCOM.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\NativeCOM.manifest" Link="NativeCOM.manifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\NativeLifetimeProbe.dll" Link="NativeLifetimeProbe.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\vcruntime*.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\ucrtbased.dll" Link="ucrtbased.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
