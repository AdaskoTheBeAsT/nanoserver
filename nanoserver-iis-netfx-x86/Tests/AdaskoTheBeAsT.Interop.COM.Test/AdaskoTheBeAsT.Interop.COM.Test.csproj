<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net48;net481;net10.0;net11.0</TargetFrameworks>
    <Platforms>x86;x64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AdaskoTheBeAsT.Interop.COM" Version="5.0.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.NativeCOM">
      <HintPath>..\native\Interop.NativeCOM.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\native\NativeShimRegression.exe" Link="NativeShimRegression.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\ProviderLifetimeRegression.exe" Link="ProviderLifetimeRegression.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\AtomRegression.exe" Link="AtomRegression.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\AtomStaticRegression.exe" Link="AtomStaticRegression.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\atom_fixture_*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\teardown_fixture_*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\NativeCOM.dll" Link="NativeCOM.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\NativeCOM.manifest" Link="NativeCOM.manifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\NativeLifetimeProbe.dll" Link="NativeLifetimeProbe.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\vcruntime*.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\ucrtbased.dll" Link="ucrtbased.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
